{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push * +main)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh repo edit *)"
    ]
  }
}
